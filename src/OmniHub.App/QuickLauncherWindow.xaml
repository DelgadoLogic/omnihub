<Window x:Class="OmniHub.App.QuickLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniHub Quick Launcher"
        Width="700"
        Height="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{StaticResource OmniFont}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <Border Margin="14"
            Background="{DynamicResource BgSidebarBrush}"
            BorderBrush="{DynamicResource AccentCyanBrush}"
            BorderThickness="1.5"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Search Input Row -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="⚡"
                               FontSize="18"
                               Foreground="{DynamicResource AccentCyanBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentCyanBrush}"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSearchTextChanged"/>
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Search apps, .lfc snapshots, Aeon handoffs &amp; AI models..."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Border Grid.Column="2"
                            Background="{DynamicResource BgCardElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="ESC"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Results List -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,9">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource NavActiveFillBrush}"/>
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Item.Title}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Item.Subtitle}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource BgCardElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                                <TextBlock Text="{Binding Item.BadgeText}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentCyanBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgHeaderBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,15,15"
                    Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterStatusText"
                               Text="↑↓ Navigate   •   ↵ Execute   •   Esc Dismiss"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="DelgadoLogic OmniHub"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPurpleBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
